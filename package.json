{
  "name": "@iori7295/searxng-mcp",
  "version": "3.5.0",
  "description": "MCP server for SearXNG — private web search for Claude Code and LibreChat",
  "main": "build/src/index.js",
  "bin": {
    "searxng-mcp": "build/src/index.js"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/iori7295/searxng-mcp.git"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "scripts": {
    "build": "tsc && chmod 755 build/src/index.js",
    "test": "vitest run --typecheck",
    "test:watch": "vitest --typecheck",
    "lint": "biome check src/ tests/",
    "lint:fix": "biome check --write src/ tests/",
    "prepublishOnly": "pnpm build && pnpm test"
  },
  "keywords": [
    "searxng",
    "mcp",
    "search"
  ],
  "author": "iori7295",
  "license": "MIT",
  "packageManager": "pnpm@10.30.3",
  "engines": {
    "node": ">=20"
  },
  "files": [
    "build/src/",
    "README.md",
    "LICENSE",
    "CHANGELOG.md",
    "domains.json"
  ],
  "dependencies": {
    "@lancedb/lancedb": "^0.27.2",
    "@langchain/textsplitters": "^1.0.1",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@mozilla/readability": "^0.5.0",
    "apache-arrow": "^18.1.0",
    "defuddle": "^0.18.1",
    "iovalkey": "^0.3.3",
    "ipaddr.js": "^2.4.0",
    "js-tiktoken": "^1.0.21",
    "linkedom": "^0.18.12",
    "pdf-parse": "^2.4.5",
    "pino": "^9.14.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.12",
    "@types/node": "^22.13.10",
    "typescript": "^5.8.2",
    "vitest": "^4.1.3"
  },
  "pnpm": {
    "overrides": {
      "path-to-regexp": ">=8.4.0",
      "hono": ">=4.12.18",
      "@hono/node-server": ">=1.19.13",
      "fast-uri": ">=3.1.2",
      "ip-address": ">=10.1.1"
    }
  }
}
