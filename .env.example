# =============================================================================
# searxng-mcp — 環境変数設定例
# =============================================================================

# === 必須 ===
SEARXNG_URL=http://localhost:8081

# === 推奨 ===
FIRECRAWL_URL=http://localhost:3002
FIRECRAWL_API_KEY=placeholder-local

# === 任意 ===
RERANKER_URL=http://localhost:8787
LLM_BASE_URL=https://opencode.ai/zen/go/v1
LLM_API_KEY=sk-...
LLM_MODEL_EXPAND=deepseek-v4-flash
LLM_MODEL_SUMMARY=deepseek-v4-flash
VALKEY_URL=redis://localhost:6379
GITHUB_TOKEN=

# ベクトル検索（TEI + LanceDB ハイブリッド検索）
ENABLE_VECTOR_STORE=false
EMBEDDING_URL=http://localhost:8080
RERANKER_URL=http://localhost:8082
LANCEDB_PATH=./data/lancedb
VECTOR_CHUNK_SIZE=500
VECTOR_CHUNK_OVERLAP=80

# ログ
LOG_LEVEL=info
